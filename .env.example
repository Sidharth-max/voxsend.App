# voxsend (Postgres) — copy to .env and fill in. Never commit .env itself.
# Secrets (provider keys, PIN, webhook secret) are NOT kept here: they live encrypted
# (AES-256-GCM) in the database. Set them with the CLI:
#   voxsend secrets set-pin
#   voxsend secrets set sarvam_key        (prompts, input hidden)
#   voxsend secrets list                  (masked values only)

# Postgres connection for the app role (no superuser rights needed)
DATABASE_URL=postgres://voxsend:CHANGE_ME@127.0.0.1:5432/voxsend
# Schema to use. Required: there is no default.
PGSCHEMA=voxsend

# 32-byte master key file for the encrypted secrets (chmod 600). Required: there is no default.
VOXSEND_MASTER_KEY_FILE=/workspace/pg/master.key

# The scheduler (scheduled broadcasts, auto-resume) runs only when this is exactly "on".
# Production sets it on; leave it unset/off everywhere else.
VOXSEND_SCHEDULER=on

# Apply pending database migrations at startup (otherwise run: voxsend db migrate)
VOXSEND_AUTO_MIGRATE=on

PORT=3000
TZ=Asia/Kolkata

# Optional
# VOXSEND_RESUME_MINUTES=30        # auto-resume an interrupted broadcast within N minutes of its start
# SCHEDULE_GRACE_MINUTES=60        # a scheduled time missed by more than this is marked missed
# VOXSEND_CALL_SYNC=off            # disable the background Sarvam call-history sync
# VOXSEND_ALLOWED_ORIGINS=https://call.example.com   # extra origins allowed to call /api
# SARVAM_BASE_URL=https://apps.sarvam.ai   # outside prod only a localhost URL is allowed
# SARVAM_MAX_CALL_MINUTES=10
