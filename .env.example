# Copy to .env and fill in. Never commit .env itself.

# Login PIN for the app and the API tab (digits)
APP_PIN=

# Active provider: twilio | vobiz | sarvam
PROVIDER=sarvam

# Public address of this server (e.g. from `npx localtunnel --port 3000`).
# Required for Vobiz; for Sarvam it is used for call results and transcripts.
PUBLIC_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Vobiz
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM=

# Sarvam AI Voice Agents (dashboard: Settings > API Key; IDs from the dashboard URL)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
# Optional: leave empty to use the latest committed agent version
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_FROM=

# Optional
# PORT=3000
# DB_PATH=voxsend.db
# SARVAM_BASE_URL=https://apps.sarvam.ai
# SARVAM_MAX_CALL_MINUTES=10
# SCHEDULE_GRACE_MINUTES=60
